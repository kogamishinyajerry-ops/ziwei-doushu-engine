# Local server
PORT=8088

# Comma-separated browser origins allowed by FastAPI CORS.
# The built-in default already allows localhost/127.0.0.1 on 8088, 8080, and 3000.
ZIWEI_CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:3000,http://127.0.0.1:3000

# Optional LLM provider settings.
# The app does not auto-load this file; export these variables before starting.
# Leave API keys blank to use the local deterministic reading fallback.
# The LLM HTTP path uses requests from requirements.txt.
# /api/reading accepts optional provider=auto|minimax|deepseek|openai.
# Auto order is Minimax, then DeepSeek, then OpenAI.

# Preferred auto-detected provider when MINIMAX_API_KEY is set.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M2.7

# Second auto-detected provider when DEEPSEEK_API_KEY is set.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Third auto-detected provider, or use /api/reading?provider=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
